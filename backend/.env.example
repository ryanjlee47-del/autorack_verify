# Copy to backend/.env for local development. Every value has a dev default;
# the ones marked REQUIRED IN PRODUCTION are checked at startup when
# ENVIRONMENT=production (see `python -m autorack.cli check-config`).

ENVIRONMENT=development

# Neon: use the *pooled* connection string. postgresql:// URLs are accepted.
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/autorack_dev

# REQUIRED IN PRODUCTION: 32+ random characters, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
# Keys worker PIN lookups. Rotating it means every worker needs a new PIN.
SECRET_KEY=

# Where people land from emails and QR codes (your Cloudflare Pages URL). https:// in production.
FRONTEND_URL=http://localhost:8000
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:8000
# Serve ../frontend from the API process (dev, or single-host deploys).
SERVE_FRONTEND=true

# Email for sign-in links: console (prints to log) | smtp | resend
EMAIL_BACKEND=console
EMAIL_FROM=Autorack <login@yourdomain.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Set false to provision pilots by hand with `python -m autorack.cli create-warehouse`.
SIGNUP_ENABLED=true

# Billing (flat monthly price). Leave Stripe empty during free pilots.
PLAN_PRICE_CENTS=17500
TRIAL_DAYS=14
PAST_DUE_GRACE_DAYS=7
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
